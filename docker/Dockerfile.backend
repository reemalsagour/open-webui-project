FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

COPY setup-openwebui/start-backend.sh /app/start-backend.sh

RUN chmod +x /app/start-backend.sh

CMD ["/app/start-backend.sh", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
