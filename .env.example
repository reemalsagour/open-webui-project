OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=your_openwebui_admin_password
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPEN_WEB_UI_API_URL=http://open-webui:8080
POSTGRES_USER=openwebuiadmin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_HOST=YOUR_POSTGRES_SERVER_NAME.postgres.database.azure.com
POSTGRES_DB=openwebui
POSTGRES_SSL=require
# Frontend mode: true = test mode, false = real backend mode
FRONTEND_TEST_MODE=true
BACKEND_URL=http://localhost:8000